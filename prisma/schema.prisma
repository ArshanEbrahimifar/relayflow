

generator client {
  provider = "prisma-client"
  output   = "../libs/database/src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExecutionTriggerType {
  MANUAL
  WEBHOOK
}

enum StepExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workflows    Workflow[]
  executions Execution[]
}


model Workflow {
  id         String         @id @default(uuid())
  userId     String
  name       String
  status     WorkflowStatus @default(DRAFT)
  definition Json           @db.JsonB
  version    Int            @default(1)

  webhookToken     String?    @unique

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions Execution[]

  @@index([userId])
}

model Execution {
  id               String               @id @default(uuid())
  workflowId       String
  userId           String

  workflowVersion  Int
  workflowSnapshot Json                 @db.JsonB

  triggerType      ExecutionTriggerType
  triggerPayload   Json                 @db.JsonB

  status           ExecutionStatus      @default(QUEUED)

  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workflow Workflow @relation(fields: [workflowId],references: [id],onDelete: Cascade)

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  stepExecutions StepExecution[]

  @@index([userId, createdAt])
  @@index([workflowId, createdAt])
  @@index([status])
}


model StepExecution {
  id          String              @id @default(uuid())
  executionId String

  stepId      String
  stepType    String

  status      StepExecutionStatus @default(PENDING)

  input       Json?               @db.JsonB
  output      Json?               @db.JsonB

  error       String?
  attempt     Int                 @default(1)

  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  execution Execution @relation(fields: [executionId],references: [id],onDelete: Cascade)

  @@unique([executionId, stepId])
  @@index([executionId])
}